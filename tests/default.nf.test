nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            def lines  = new File("$outputDir/gencorr_results.tsv").readLines()
            def header = lines[0].split('\t', -1) as List
            def rows   = lines.drop(1).collect { line -> [header, line.split('\t', -1) as List].transpose().collectEntries() }
            // Content snapshot that is robust to last-digit floating point noise
            // across platforms/BLAS: rg rounded to 3 decimals + status per row.
            def summary = rows.collect { r ->
                def rg = r.rg == 'NA' ? 'NA' : String.format('%.3f', r.rg as double)
                "${r.method}|${r.trait1}|${r.trait2}|${r.locus}|${r.status}|${rg}"
            }
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true,
                ignore: ['pipeline_info/*.{html,json,txt}'])
            assert workflow.success
            assertAll(
                // every pair analysed by LDSC; 6 pairs x 10 loci for LAVA
                { assert rows.count { it.method == 'ldsc' } == 6 },
                { assert rows.count { it.method == 'lava' } == 60 },
                // every pair estimated by SumHer too
                { assert rows.findAll { it.method == 'sumher' }.size() == 6 },
                { assert rows.findAll { it.method == 'sumher' }.every { it.status == 'ok' } },
                { assert rows.findAll { it.method == 'ldsc' }.every { it.status == 'ok' } },
                { assert snapshot(
                    // tool versions from the "versions" topic (nf-core template);
                    // pinned identically in the container and environment.yml files
                    removeNextflowVersion("$outputDir/pipeline_info/gencorr_software_versions.yml"),
                    stable_path,
                    summary,
                    path("$outputDir/ldsc/gencorr.sample_overlap.txt"),
                    path("$outputDir/harmonized/bmi.qc.json").json
                ).match() }
            )
        }
    }

    test("-profile test -stub") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            assert workflow.success
        }
    }

    test("-stub, one trait given as a GWAS Catalog accession") {
        // wiring only: the accession row goes through GWASCATALOG_FETCH (local
        // synthetic mirror) into HARMONIZE_SUMSTATS; the file row does not

        options "-stub"

        when {
            params {
                outdir           = "$outputDir"
                input            = "${projectDir}/tests/data/samplesheet_gwascatalog.csv"
                gwascatalog_base = "${projectDir}/tests/data/gwascatalog"
            }
        }

        then {
            def tasks = workflow.trace.succeeded().collect { t -> t.name }
            assertAll(
                { assert workflow.success },
                { assert tasks.count { n -> n.contains('GWASCATALOG_FETCH') } == 1 },
                { assert tasks.any { n -> n.contains('GWASCATALOG_FETCH (synthetic:GCST90000999)') } },
                { assert tasks.count { n -> n.contains('HARMONIZE_SUMSTATS') } == 2 }
            )
        }
    }

    test("-profile test, mixed ancestry (EUR + EAS)") {
        // bmi, depression: EUR (depression via the default); neuro, rheuma: EAS.
        // The EAS references are the same test files as EUR (stand-ins): the test
        // checks the routing (which pairs run, with which group), not the numbers.

        when {
            params {
                outdir        = "$outputDir"
                input         = "${projectDir}/tests/data/samplesheet_ancestry.csv"
                ldsc_ld_eas   = "${projectDir}/tests/data/ldsc"
                lava_ref_eas  = 'https://raw.githubusercontent.com/josefin-werme/LAVA/e729a245f7b6923967a96804fbf5246eadf2d6c6/vignettes/data/g1000_test'
                sumher_tagfile_eas = "${projectDir}/tests/data/sumher/ldak.thin.test.tagging.gz"
                lava_snp_set  = 'joint'
            }
        }

        then {
            def lines  = new File("$outputDir/gencorr_results.tsv").readLines()
            def header = lines[0].split('\t', -1) as List
            def rows   = lines.drop(1).collect { line -> [header, line.split('\t', -1) as List].transpose().collectEntries() }
            def pair   = { r -> [r.trait1, r.trait2].sort().join('|') }
            def cross  = ['bmi|neuro', 'bmi|rheuma', 'depression|neuro', 'depression|rheuma'] as Set
            assert workflow.success
            assertAll(
                // 4 cross-ancestry pairs x 3 methods (ldsc, lava, sumher): one row each, not estimated
                { assert rows.findAll { r -> r.status == 'cross_ancestry' }.size() == 12 },
                { assert rows.findAll { r -> r.method == 'sumher' && r.status == 'ok' }.collect { r -> pair(r) }.toSet() == ['bmi|depression', 'neuro|rheuma'] as Set },
                { assert rows.findAll { r -> r.status == 'cross_ancestry' }.collect { r -> pair(r) }.toSet() == cross },
                { assert rows.findAll { r -> r.status == 'cross_ancestry' }.every { r -> r.rg == 'NA' && r.extra.contains('"ancestry_1"') } },
                // same-ancestry pairs are estimated: bmi|depression (EUR), neuro|rheuma (EAS)
                { assert rows.findAll { r -> r.method == 'ldsc' && r.status == 'ok' }.collect { r -> pair(r) }.toSet() == ['bmi|depression', 'neuro|rheuma'] as Set },
                { assert rows.findAll { r -> r.method == 'lava' && r.status != 'cross_ancestry' }.collect { r -> pair(r) }.toSet() == ['bmi|depression', 'neuro|rheuma'] as Set },
                // joint LAVA groups are per ancestry: neuro and rheuma are not loaded with EUR traits
                { assert new File("$outputDir/lava/gencorr.lava_univ.tsv").readLines().drop(1)
                        .collect { line -> line.split('\t')[10] }.toSet() == ['bmi;depression', 'neuro;rheuma'] as Set }
            )
        }
    }

    test("Popcorn: cross-ancestry pair (Popcorn's own EUR/EAS test data)") {
        // Score file tests/data/popcorn was computed from Popcorn's test reference
        // panels (EUR_ref, EAS_ref) with the gencorr-popcorn image.

        // given on the command line (the text "false" with Nextflow's default parser;
        // see tests/python/test_cli_options.py for that case)
        options "--popcorn_gen_effect false"

        when {
            params {
                outdir        = "$outputDir"
                input         = "${projectDir}/tests/data/samplesheet_popcorn.csv"
                methods       = 'popcorn'
                popcorn_cfile = "${projectDir}/tests/data/popcorn/EUR_EAS.test.cscore.gz"
            }
        }

        then {
            def lines  = new File("$outputDir/gencorr_results.tsv").readLines()
            def header = lines[0].split('\t', -1) as List
            def rows   = lines.drop(1).collect { line -> [header, line.split('\t', -1) as List].transpose().collectEntries() }
            assert workflow.success
            assertAll(
                { assert rows.size() == 1 },
                { assert rows[0].method == 'popcorn' && rows[0].status == 'ok' },
                // EUR trait first, as in the score file
                { assert [rows[0].trait1, rows[0].trait2] == ['eur_t', 'eas_t'] },
                // same estimate as Popcorn run directly on the raw test files (pgi 0.5195)
                { assert String.format('%.4f', rows[0].rg as double) == '0.5195' },
                { assert rows[0].extra.contains('"correlation": "genetic_impact"') },
                { assert rows[0].extra.contains('"p_pg_lt_1"') }
            )
        }
    }

    test("-profile test, pair_mode target, joint LAVA SNP set") {

        // true/false options given on the command line must mean false. nf-test needs
        // NXF_SYNTAX_PARSER=v1, which turns them into real booleans; the default parser
        // passes the text "false" instead, tested in tests/python/test_cli_options.py
        options "--sumher_genomic_control false --save_intermediates false --drop_ambiguous false"

        when {
            params {
                outdir       = "$outputDir"
                pair_mode    = 'target'
                targets      = 'depression'
                lava_snp_set = 'joint'
            }
        }

        then {
            def lines  = new File("$outputDir/gencorr_results.tsv").readLines()
            def header = lines[0].split('\t', -1) as List
            def rows   = lines.drop(1).collect { line -> [header, line.split('\t', -1) as List].transpose().collectEntries() }
            def sumherLogs = new File("$outputDir/sumher/logs").listFiles().findAll { f -> f.name.endsWith('.log') }
            assert workflow.success
            assertAll(
                // depression vs the 3 other traits
                { assert rows.findAll { it.method == 'ldsc' }.collect { [it.trait1, it.trait2].sort() }.unique().size() == 3 },
                { assert rows.findAll { it.method == 'lava' }.every { 'depression' in [it.trait1, it.trait2] } },
                { assert sumherLogs.size() == 3 },
                { assert sumherLogs.every { f -> f.text.contains('--genomic-control NO') } },
                { assert !new File("$outputDir/lava/chunks").exists() },
                { assert new File("$outputDir/harmonized").listFiles().every { f -> f.name.endsWith('.qc.json') } },
                // the strand_ambiguous filter only appears in the QC report when it ran
                { assert !new File("$outputDir/harmonized/depression.qc.json").text.contains('strand_ambiguous') }
            )
        }
    }
}
