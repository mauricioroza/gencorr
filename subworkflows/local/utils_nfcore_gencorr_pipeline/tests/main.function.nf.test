nextflow_function {

    name "Test pairing and validation functions"
    script "../main.nf"
    tag "subworkflows"
    tag "utils_nfcore_gencorr_pipeline"

    test("makePairs: all -> every unordered pair once, samplesheet order") {
        function "makePairs"
        when {
            function {
                """
                input[0] = ['a', 'b', 'c']
                input[1] = 'all'
                input[2] = null
                input[3] = null
                """
            }
        }
        then {
            assert function.success
            assert function.result == [['a', 'b'], ['a', 'c'], ['b', 'c']]
        }
    }

    test("makePairs: target -> target vs every other trait, no duplicates between targets") {
        function "makePairs"
        when {
            function {
                """
                input[0] = ['a', 'b', 'c', 'd']
                input[1] = 'target'
                input[2] = 'b,a'
                input[3] = null
                """
            }
        }
        then {
            assert function.success
            // b-a is produced once (as b,a) even though a is also a target
            assert function.result == [['b', 'a'], ['b', 'c'], ['b', 'd'], ['a', 'c'], ['a', 'd']]
        }
    }

    test("makePairs: pairs -> listed pairs, reversed duplicates removed") {
        function "makePairs"
        when {
            function {
                """
                input[0] = ['a', 'b', 'c']
                input[1] = 'pairs'
                input[2] = null
                input[3] = [['a', 'c'], ['c', 'a'], ['b', 'c']]
                """
            }
        }
        then {
            assert function.success
            assert function.result == [['a', 'c'], ['b', 'c']]
        }
    }

    test("makePairs: unknown target fails") {
        function "makePairs"
        when {
            function {
                """
                input[0] = ['a', 'b']
                input[1] = 'target'
                input[2] = 'z'
                input[3] = null
                """
            }
        }
        then {
            assert function.failed
        }
    }

    test("makePairs: self pair fails") {
        function "makePairs"
        when {
            function {
                """
                input[0] = ['a', 'b']
                input[1] = 'pairs'
                input[2] = null
                input[3] = [['a', 'a']]
                """
            }
        }
        then {
            assert function.failed
        }
    }

    test("validatePopcornAncestries: score-file order is kept") {
        function "validatePopcornAncestries"
        when {
            function {
                """
                input[0] = 'EAS, EUR'
                """
            }
        }
        then {
            assert function.success
            assert function.result == ['EAS', 'EUR']
        }
    }

    test("validatePopcornAncestries: one ancestry twice fails") {
        function "validatePopcornAncestries"
        when {
            function {
                """
                input[0] = 'EUR,EUR'
                """
            }
        }
        then {
            assert function.failed
        }
    }

    test("popcornScoreSources: table row, then --popcorn_cfile, then compute; AMR skipped") {
        function "popcornScoreSources"
        when {
            function {
                """
                input[0] = [ popcorn_cfile: '/s/eas_eur.cscore', popcorn_cfile_ancestries: 'EAS,EUR',
                             popcorn_ref: '/r/g1000_eur', popcorn_ref_afr: '/r/g1000_afr' ]
                input[1] = [ ['SAS', 'EUR', '/s/sas_eur.cscore'] ]
                input[2] = [ ['EUR', 'EAS'], ['EAS', 'EUR'], ['EUR', 'SAS'], ['AFR', 'EUR'], ['EUR', 'AMR'] ]
                """
            }
        }
        then {
            assert function.success
            assert function.result == [
                [ ancestries: ['EAS', 'EUR'], cfile: '/s/eas_eur.cscore' ],   // file order kept
                [ ancestries: ['SAS', 'EUR'], cfile: '/s/sas_eur.cscore' ],
                [ ancestries: ['EUR', 'AFR'], cfile: null ]                   // computed, EUR first
            ]
        }
    }

    test("popcornScoreSources: ancestry pair without score file or references fails") {
        function "popcornScoreSources"
        when {
            function {
                """
                input[0] = [ popcorn_cfile: '/s/eur_eas.cscore', popcorn_cfile_ancestries: 'EUR,EAS', popcorn_ref: '/r/g1000_eur' ]
                input[1] = []
                input[2] = [ ['EUR', 'AFR'] ]
                """
            }
        }
        then {
            assert function.failed
            assert (function.stdout + function.stderr).any { line -> line.contains('--popcorn_ref_afr') }
        }
    }

    test("ancestrySetting: per-ancestry value, else the EUR one") {
        function "ancestrySetting"
        when {
            function {
                """
                input[0] = [ldsc_ld_prefix: '', ldsc_ld_prefix_afr: 'UKBB.AFR', ldsc_ld_prefix_sas: null]
                input[1] = 'ldsc_ld_prefix'
                input[2] = 'SAS'
                """
            }
        }
        then {
            assert function.success
            assert function.result == ''
        }
    }

    test("isMultiAncestryPair: any MULTI trait") {
        function "isMultiAncestryPair"
        when {
            function {
                """
                input[0] = [id: 'mdd_meta', ancestry: 'MULTI']
                input[1] = [id: 'bmi']
                """
            }
        }
        then {
            assert function.success
            assert function.result == true
        }
    }

    test("validateReferences: AFR same-ancestry pairs need --ldsc_ld_afr") {
        function "validateReferences"
        when {
            function {
                """
                input[0] = [ldsc_ld: '/refs/eur', ldsc_ld_afr: null]
                input[1] = ['ldsc']
                input[2] = ['AFR', 'EUR']
                """
            }
        }
        then {
            assert function.failed
            assert (function.stdout + function.stderr).any { line -> line.contains('--ldsc_ld_afr') }
        }
    }

    test("validateReferences: all references present") {
        function "validateReferences"
        when {
            function {
                """
                input[0] = [ldsc_ld: '/refs/eur', ldsc_ld_sas: '/refs/sas']
                input[1] = ['ldsc']
                input[2] = ['EUR', 'SAS']
                """
            }
        }
        then {
            assert function.success
        }
    }

    test("cleanMeta: empty samplesheet cells are dropped") {
        function "cleanMeta"
        when {
            function {
                """
                input[0] = [id: 'x', n: null, n_cases: [], pop_prev: 0.1, colmap: '']
                """
            }
        }
        then {
            assert function.success
            assert function.result == [id: 'x', pop_prev: 0.1]
        }
    }

    test("validateSamples: pop_prev with samp_prev or n_cases/n_controls passes") {
        function "validateSamples"
        when {
            function {
                """
                input[0] = [ [[id: 'mdd', pop_prev: 0.15, samp_prev: 0.5], []],
                             [[id: 'scz', pop_prev: 0.01, n_cases: 100, n_controls: 300], []] ]
                """
            }
        }
        then {
            assert function.success
        }
    }

    test("validateSamples: pop_prev without a sample prevalence fails") {
        function "validateSamples"
        when {
            function {
                """
                input[0] = [ [[id: 'mdd', pop_prev: 0.15], []], [[id: 'bmi'], []] ]
                """
            }
        }
        then {
            assert function.failed
        }
    }
}
