/*
 * Settings for running gencorr on one OCI VM with the local executor.
 * Not used directly: bootstrap_vm.sh writes /data/gencorr_vm.config, which
 * includes this file and adds the VM's CPU/memory limits. Run with
 *
 *   nextflow run ~/gencorr/main.nf -profile docker -c /data/gencorr_vm.config ...
 */

workDir = '/data/work'

process {
    // LAVA chunks peak at ~3.7 GB RSS on one CPU (genome-wide g1000_eur
    // reference). The default 6 GB request would leave CPUs idle on a VM with
    // ~5 GB per vCPU; a retry after an out-of-memory kill doubles it.
    withName: '.*:METHOD_LAVA:LAVA_RUN' {
        memory = { 5.GB * task.attempt }
    }
}

// One thread per task: Nextflow already runs one task per CPU, and
// data.table / BLAS would otherwise each start threads for every core.
// Results do not depend on the thread count (LAVA seeds are per locus).
env {
    OMP_NUM_THREADS         = '1'
    OPENBLAS_NUM_THREADS    = '1'
    MKL_NUM_THREADS         = '1'
    R_DATATABLE_NUM_THREADS = '1'
}

trace.overwrite    = true
timeline.overwrite = true
report.overwrite   = true
