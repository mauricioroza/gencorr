/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for a larger test
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Same 4 vignette traits as `test`, but all 42 LAVA vignette loci and the
    LDSC-derived sample-overlap correction. ~20-30 CPU-minutes.

    Use as follows:
        nextflow run karlssonlab/gencorr -profile test_full,<docker/singularity> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

includeConfig 'test.config'

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'All 42 LAVA vignette loci'

    lava_loci           = 'https://raw.githubusercontent.com/josefin-werme/LAVA/e729a245f7b6923967a96804fbf5246eadf2d6c6/vignettes/data/test.loci'
    lava_loci_per_chunk = 10
}
