/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    --ldsc_impl py3: LDSC from the CBIIT/ldsc Python 3 port
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Included by nextflow.config only when --ldsc_impl py3. The LDSC modules' own
    container is the original LDSC 1.0.1 biocontainer; this swaps in the image
    built from containers/gencorr-ldsc (docs/ldsc_py3.md). LDSC_SUMMARISE only
    parses logs and stays in gencorr-tools.
----------------------------------------------------------------------------------------
*/

process {
    withName: '.*:METHOD_LDSC:LDSC_(MUNGE|H2|RG)' {
        container = 'ghcr.io/mauricioroza/gencorr-ldsc:3.0.1-128f996'
    }
}
