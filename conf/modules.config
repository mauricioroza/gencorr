/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Per-process options: tool arguments (ext.args) and where outputs are published
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Output layout (docs/output.md):

      <outdir>/gencorr_results.tsv        all methods, one standard table
      <outdir>/harmonized/                QC reports (+ harmonized files if --save_harmonized)
      <outdir>/ldsc/                      LDSC results, per-trait h2, sample overlap, logs
      <outdir>/lava/                      LAVA results, local univariate h2
      <outdir>/pipeline_info/             software versions, execution reports
----------------------------------------------------------------------------------------
*/

process {

    // Default: do not publish. Every published output is listed explicitly
    // below, so the results folder only contains files someone needs.
    publishDir = [ enabled: false ]

    withName: 'GWASCATALOG_FETCH' {
        ext.args   = { "--base ${params.gwascatalog_base}" }
        // keep downloads across runs when --gwascatalog_cache is set
        storeDir   = { params.gwascatalog_cache ? "${params.gwascatalog_cache}/${meta.gwas_catalog}" : null }
    }

    withName: 'HARMONIZE_SUMSTATS' {
        ext.args   = { [
            "--z-priority ${params.z_priority}",
            params.drop_ambiguous.toString() == 'true' ? '--drop-ambiguous' : '',
            params.min_info > 0 ? "--min-info ${params.min_info}" : '',   // 0 = off
            params.min_maf  > 0 ? "--min-maf ${params.min_maf}"   : ''
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/harmonized" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.endsWith('.qc.json') || params.save_harmonized.toString() == 'true' ? fn : null }
        ]
    }

    // ---------------------------------------------------------------- LDSC --
    withName: '.*:METHOD_LDSC:LDSC_MUNGE' {
        publishDir = [
            path: { "${params.outdir}/ldsc/munged" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.endsWith('.log') || params.save_intermediates.toString() == 'true' ? fn : null }
        ]
    }
    withName: '.*:METHOD_LDSC:LDSC_(H2|RG)' {
        publishDir = [
            path: { "${params.outdir}/ldsc/logs" },
            mode: params.publish_dir_mode
        ]
    }
    withName: '.*:METHOD_LDSC:LDSC_SUMMARISE' {
        publishDir = [
            path: { "${params.outdir}/ldsc" },
            mode: params.publish_dir_mode
        ]
    }

    // ---------------------------------------------------------------- LAVA --
    withName: '.*:METHOD_LAVA:LAVA_RUN' {
        ext.args   = { [
            "--univ-thresh ${params.lava_univ_thresh}",
            "--adap-thresh ${params.lava_adap_thresh}",
            "--param-lim ${params.lava_param_lim}",
            "--p-values ${params.lava_p_values}",
            "--cis ${params.lava_cis}",
            "--seed ${params.lava_seed}",
            "--snp-set ${params.lava_snp_list ? params.lava_snp_list.toString().tokenize('/').last() : 'all'}"
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/lava/chunks" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates.toString() == 'true'
        ]
    }
    withName: '.*:METHOD_LAVA:MERGE_RESULTS' {
        publishDir = [
            path: { "${params.outdir}/lava" },
            mode: params.publish_dir_mode
        ]
    }

    // -------------------------------------------------------------- SumHer --
    withName: '.*:METHOD_SUMHER:SUMHER_RG' {
        // Same options as BigaGWAS (sumHer_2traits.sh); cutoff/genomic control are params
        ext.args   = { [
            '--check-sums NO',
            '--allow-ambiguous YES',
            "--cutoff ${params.sumher_cutoff}",
            "--genomic-control ${params.sumher_genomic_control.toString() == 'true' ? 'YES' : 'NO'}"
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/sumher/logs" },
            mode: params.publish_dir_mode
        ]
    }
    withName: '.*:METHOD_SUMHER:SUMHER_SUMMARISE' {
        publishDir = [
            path: { "${params.outdir}/sumher" },
            mode: params.publish_dir_mode
        ]
    }

    // ------------------------------------------------------------- Popcorn --
    withName: '.*:METHOD_POPCORN:POPCORN_FIT' {
        ext.args   = { [
            params.popcorn_gen_effect.toString() == 'true' ? '--gen_effect' : '',
            params.popcorn_use_mle.toString() == 'true' ? '--use_mle'    : ''
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/popcorn/logs" },
            mode: params.publish_dir_mode
        ]
    }
    withName: '.*:METHOD_POPCORN:POPCORN_SUMMARISE' {
        publishDir = [
            path: { "${params.outdir}/popcorn" },
            mode: params.publish_dir_mode
        ]
    }

    // ------------------------------------------------------------- Results --
    withName: 'MERGE_ALL' {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode
        ]
    }
}
