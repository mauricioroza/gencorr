/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    4 traits from the LAVA vignette, 6 pairs, LDSC + LAVA + SumHer on 10 small loci.
    Runs in a few minutes on a laptop.

    Data: summary statistics, genotype reference and loci are read directly
    from the pinned LAVA commit on GitHub (nothing from LAVA is copied into this
    repository); the LDSC LD scores in tests/data/ldsc were derived from that
    reference with tests/data/make_test_data.sh, and so was the small LDAK
    tagging file in tests/data/sumher (SNPs of the 10 test loci only).

    The trait formats were chosen to exercise the harmonizer:
      bmi        continuous, BETA/SE/P, CHR/BP, N in NMISS
      neuro      continuous, explicit Z column, N in N_analyzed
      depression binary, LogOR + OR, lower-case alleles, no CHR/BP
      rheuma     binary, OR + P only (no SE), no CHR/BP

    Use as follows:
        nextflow run mauricioroza/gencorr -profile test,<docker/singularity> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    input                = "${projectDir}/tests/data/samplesheet.csv"
    methods              = 'ldsc,lava,sumher'
    pair_mode            = 'all'

    ldsc_ld              = "${projectDir}/tests/data/ldsc"
    ldsc_ld_prefix       = 'all'
    ldsc_ld_split_by_chr = false
    ldsc_merge_alleles   = "${projectDir}/tests/data/ldsc/merge_alleles.snplist.gz"
    ldsc_rg_batch_size   = 2      // forces >1 rg batch per trait to exercise batching

    lava_ref             = 'https://raw.githubusercontent.com/josefin-werme/LAVA/e729a245f7b6923967a96804fbf5246eadf2d6c6/vignettes/data/g1000_test'
    lava_loci            = "${projectDir}/tests/data/test_10.loci"
    lava_loci_per_chunk  = 4      // 10 loci -> 3 chunks, exercises chunking
    lava_overlap         = 'ldsc'

    // tagging file built from the rsID-named test reference, so no --sumher_snp_positions
    sumher_tagfile       = "${projectDir}/tests/data/sumher/ldak.thin.test.tagging.gz"
}
